@section Scripts {
    <script>
        function switchPortalTab(tabName, btnElement) {
            // Hide all tab panels
            document.querySelectorAll('.portal-view-panel').forEach(function(panel) {
                panel.style.display = 'none';
            });

            // Remove active class from all pill buttons
            document.querySelectorAll('.portal-nav-pill').forEach(function(btn) {
                btn.classList.remove('active');
            });

            // Show target panel
            var targetPanel = document.getElementById('tab-' + tabName);
            if (targetPanel) {
                targetPanel.style.display = 'block';
            }

            // Set active class on clicked button
            if (btnElement) {
                btnElement.classList.add('active');
            }
        }
    </script>
}