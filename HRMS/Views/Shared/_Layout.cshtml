                <header class="dashboard-topbar">

                    <div class="d-flex align-items-center gap-3">

                        <button class="btn btn-hrms-soft d-lg-none"
                                type="button"
                                onclick="toggleSidebar()">

                            <i class="bi bi-list fs-5"></i>

                        </button>

                        <div class="topbar-welcome d-none d-sm-flex align-items-center gap-2">

                            <div class="topbar-date-badge">

                                <i class="bi bi-calendar-event me-1"></i>

                                <span>
                                    @DateTime.Now.ToString("dddd, dd MMMM yyyy")
                                </span>

                            </div>

                            <span class="topbar-quote-tag font-hand d-none d-md-inline">
                                ✨ Make today wonderfully productive ♡
                            </span>

                        </div>

                    </div>

                    <div class="topbar-actions">

                        <!-- Theme Toggle -->
                        <button type="button"
                                class="theme-toggle-btn"
                                onclick="toggleTheme()">

                            <span class="theme-toggle-icon">🌸</span>
                            <span>Cute Mode</span>

                        </button>

                        <div class="d-flex align-items-center gap-2">

                            <div class="sidebar-avatar"
                                 style="width:36px; height:36px; font-size:13px;">

                                @(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "U")

                            </div>

                            <span class="d-none d-md-inline fw-semibold"
                                  style="font-size: 13px; color: var(--hrms-text-primary);">

                                @User.Identity?.Name

                            </span>

                        </div>

                    </div>

                </header>

                <!-- ================= PAGE CONTENT ================= -->
                <main class="dashboard-content">
                    @RenderBody()
                </main>

                <!-- FOOTER -->
                <footer class="hrms-footer">
                    © @DateTime.Now.Year HRMS · Workforce Hub · Crafted with Care & Elegance ♡
                </footer>

            </div>

        </div>
    }
    else
    {
        <!-- ================= PUBLIC / NON-AUTHENTICATED LAYOUT ================= -->

        <header class="hrms-navbar">

            <a asp-controller="Home"
               asp-action="Index"
               class="brand">

                <div class="brand-icon">
                    ♡
                </div>

                <div class="brand-text">

                    <div class="brand-name">HRMS</div>
                    <div class="brand-subtitle">WORKFORCE HUB</div>

                </div>

            </a>

            <nav class="nav-center d-none d-md-flex">

                <a asp-controller="Home"
                   asp-action="Index"
                   class="nav-link-custom">
                    Home
                </a>

                <a href="/#about"
                   class="nav-link-custom">
                    About
                </a>

                <a href="/#features"
                   class="nav-link-custom">
                    Features
                </a>

            </nav>

            <div class="nav-right">

                <!-- Theme Toggle -->
                <button type="button"
                        class="theme-toggle-btn"
                        onclick="toggleTheme()">

                    <span class="theme-toggle-icon">🌸</span>
                    <span>Cute Mode</span>

                </button>

                <a asp-area="Identity"
                   asp-page="/Account/Login"
                   class="btn-hrms-outline">
                    Login
                </a>

                <a asp-area="Identity"
                   asp-page="/Account/Register"
                   class="btn-hrms-primary">
                    Register
                </a>

            </div>

        </header>

        <main>
            @RenderBody()
        </main>

        <footer class="hrms-footer">
            © @DateTime.Now.Year HRMS · Workforce Hub · Better People · Brighter Tomorrows ♡
        </footer>
    }

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>